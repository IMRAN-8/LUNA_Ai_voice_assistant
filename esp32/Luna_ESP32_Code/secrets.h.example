// ---------------------------------------------------------------------
//  Luna ESP32-S3 — credentials template
//
//  1. Copy this file to `secrets.h` (same folder)
//  2. Fill in your own values
//  3. Never commit `secrets.h` — it is already in .gitignore
// ---------------------------------------------------------------------
#pragma once

// Your 2.4 GHz Wi-Fi network (the ESP32-S3 does not support 5 GHz)
#define WIFI_SSID      "YOUR_WIFI_SSID"
#define WIFI_PASSWORD  "YOUR_WIFI_PASSWORD"

// Base URL of your deployed Luna server, with NO trailing slash.
// Example: "https://my-luna-server.onrender.com"
#define SERVER_BASE_URL "https://YOUR-SERVER.onrender.com"
